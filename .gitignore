# Gradle and JVM build outputs
.gradle/
.gradle-home/
build/
out/
*.class
*.jar
# The wrapper is required in a fresh checkout, including with global *.jar rules.
!gradle/wrapper/gradle-wrapper.jar

# Local configuration and credentials
snowflake.properties
*.local.properties
secrets/
*.pem
*.p8
*.key
.env
.env.*
*.env
!.env.example

# Python helper environments and generated files; keep uv.lock versioned.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
.uv/
.pytest_cache/
.coverage
htmlcov/
__cache__/

# Editor and OS state
.idea/
*.iml
.vscode/
.DS_Store
.claude/

# Generated data and logs; ordinary text files remain versionable.
*.parquet
*.log
